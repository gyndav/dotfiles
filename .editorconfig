root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
quote_type = double # unsupported at this point

[Makefile]
indent_style = tab
indent_size = 4

[.gitconfig]
indent_style = tab
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.sh]
indent_style = space
indent_size = 2

# fish_indent (the fish formatter) uses 4 spaces
[*.fish]
indent_style = space
indent_size = 4
