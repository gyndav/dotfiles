#!/usr/bin/env sh

if ! type 'brew' >/dev/null 2>&1; then
  echo '--> Installing Homebrew'
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

# Ensure Homebrew is in PATH (needed when running from a bare shell)
if [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

DOTFILES="$(cd "$(dirname "$0")/.." && pwd)"

# Packages are declared in the Brewfile. `brew bundle` keeps going past a
# package that fails and exits non-zero at the end; carry on with the rest of
# the bootstrap either way so one unavailable cask never blocks the setup.
echo '--> BREW ALL THE THINGS!'
if ! brew bundle --file "$DOTFILES/Brewfile"; then
  echo '!!! Some Brewfile entries failed to install; see above. Continuing.' >&2
fi

echo '--> LETS CODE!'

echo '--> Symlinking dotfiles'
"$DOTFILES/bin/symlink-dotfiles"

echo '--> Installing git hooks'
(cd "$DOTFILES" && mise trust && mise install && mise exec -- lefthook install)

echo '--> Setting fish as default shell'
FISH="$(brew --prefix)/bin/fish"
if ! grep -qx "$FISH" /etc/shells; then
  echo "$FISH" | sudo tee -a /etc/shells
fi
if [ "$(dscl . -read "/Users/$USER" UserShell | awk '{print $2}')" != "$FISH" ]; then
  chsh -s "$FISH"
fi

# local files
if [ ! -f ~/.localrc.fish ]; then
  touch ~/.localrc.fish
fi

echo '--> Cleanup Homebrew formulas'
brew cleanup

echo '--> Refreshing terminal'
exec "$FISH"
