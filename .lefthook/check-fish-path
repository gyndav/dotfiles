#!/usr/bin/env sh
# Keep fish/config.fish the single source of truth for PATH: reject the lines
# installers like to append to fish files (Docker Desktop's `export PATH=...`,
# universal `fish_add_path`, `set -U fish_user_paths`). Each command on a line
# (split on ; && || |) is checked on its own; comments are ignored.
# Usage: check-fish-path <file.fish>...

set -eu

status=0
for f in "$@"; do
  awk -v file="$f" '
    # Does the option list (tokens 2..n up to the first non-option) contain
    # the short flag `s` or the long flag `l`?
    function hasopt(s, l,    i) {
      for (i = 2; i <= n; i++) {
        if (t[i] == "--") return 0
        if (t[i] !~ /^-/) return 0
        if (t[i] == "--" l) return 1
        if (t[i] !~ /^--/ && index(substr(t[i], 2), s)) return 1
      }
      return 0
    }
    function firstarg(    i) {
      for (i = 2; i <= n; i++) if (t[i] !~ /^-/) return t[i]
      return ""
    }
    function check(seg,    bad, cmd, var, i) {
      n = split(seg, t, /[[:space:]]+/)
      if (t[1] == "") { for (i = 1; i < n; i++) t[i] = t[i + 1]; n-- }
      # Strip leading keywords: `and set ...`, `not set -q ...`
      while (n > 0 && t[1] ~ /^(and|or|not|command|builtin|begin|if|else|while)$/) {
        for (i = 1; i < n; i++) t[i] = t[i + 1]
        n--
      }
      if (n == 0) return
      cmd = t[1]
      bad = ""
      if (cmd == "export") {
        for (i = 2; i <= n; i++) if (t[i] ~ /^PATH=/) bad = "sets PATH with export"
      } else if (cmd == "set") {
        var = firstarg()
        if (!hasopt("q", "query")) {
          if (var == "PATH") bad = "sets PATH directly"
          else if (var == "fish_user_paths" && hasopt("U", "universal") && !hasopt("e", "erase"))
            bad = "universal fish_user_paths"
        }
      } else if (cmd == "fish_add_path") {
        if (!hasopt("g", "global")) bad = "fish_add_path without --global (defaults to universal)"
      }
      if (bad != "") {
        printf "%s:%d: %s\n    %s\n", file, NR, bad, $0
        found = 1
      }
    }
    {
      line = $0
      sub(/(^|[[:space:]])#.*$/, "", line)   # comments (whole-line or trailing)
      nseg = split(line, segs, /;|&&|\|\||\|/)
      for (j = 1; j <= nseg; j++) check(segs[j])
    }
    END { exit found }
  ' "$f" >&2 || status=1
done

if [ "$status" -ne 0 ]; then
  echo "Add PATH entries to the ordered fish_add_path --global list in fish/config.fish instead." >&2
fi
exit "$status"
